# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/
next-env.d.ts

# Production build
/build

# Environment variables — NEVER commit real secrets (MongoDB URI, JWT
# secret, Cloudinary keys, etc.). Only .env.local.example should be tracked.
.env
.env.local
.env.*.local

# TypeScript incremental build info
*.tsbuildinfo

# Testing / coverage
/coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editor/OS cruft
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Vercel
.vercel
