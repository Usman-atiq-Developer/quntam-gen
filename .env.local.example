# Copy this file to .env.local and fill in real values before running the app.

# ── Database (required) ──────────────────────────────────────────────
# MongoDB Atlas connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas, add a database user, allow your IP
# (or 0.0.0.0/0 for Vercel), and copy the connection string here.
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/quntamgen?retryWrites=true&w=majority
MONGODB_URI=

# ── Admin authentication (required) ──────────────────────────────────
# A long, random secret used to sign admin login sessions (JWT). Generate
# one with: openssl rand -base64 32
JWT_SECRET=

# Used only by `npm run seed:admin` to create/reset the admin account.
# Not read anywhere else, and not needed after you've created the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Image uploads — Cloudinary (required for uploading images) ───────
# Sign up free at https://cloudinary.com, then find these on your dashboard
# home page under "Product Environment Credentials".
# Without these, you can still paste image URLs manually, but the
# drag-and-drop uploader in the admin dashboard won't work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: folder inside Cloudinary where uploads are stored (default: quntam-gen)
CLOUDINARY_FOLDER=quntam-gen

# ── Optional integrations ────────────────────────────────────────────
# Used in app/api/contact/route.ts if you wire up Resend for email notifications
RESEND_API_KEY=

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_ID=

# Google Search Console verification (optional, or verify via DNS instead).
# Rendered as a <meta name="google-site-verification"> tag in app/layout.tsx.
NEXT_PUBLIC_GSC_VERIFICATION=

# The site's canonical absolute URL, no trailing slash — used for canonical
# URLs, the sitemap, robots.txt, and JSON-LD across the app (see
# lib/siteUrl.ts). Defaults to https://quntamgen.com if unset; only needed
# if you're deploying under a different domain (e.g. staging).
NEXT_PUBLIC_SITE_URL=https://quntamgen.com

# ── Search engine indexing — PRE-LAUNCH SAFETY SWITCH ────────────────
# Master, site-wide kill switch (see lib/indexing.ts). The site stays
# fully LIVE either way — this only controls whether search engines are
# told they may index it.
#
#   false (or unset) → site is live, but every page says
#                       noindex,nofollow (<meta> tag + X-Robots-Tag
#                       header) and the sitemap is empty. USE THIS FOR
#                       INITIAL DEPLOYMENT, before you're ready for
#                       Google to start indexing the site.
#   true              → site is indexable normally. Individual blog
#                       posts can still be excluded one at a time via
#                       the per-post indexing toggle in the admin
#                       dashboard (Post model's `robotsIndex` field) —
#                       that only matters once this is "true".
#
# Changing this requires a rebuild to take effect (npm run build).
NEXT_PUBLIC_INDEXING_ENABLED=false
